# ==============================================================================
# GitHub SSH configuration
# ==============================================================================
github_ssh_setup() {
  local email="${1:-}"
  local label="${2:-github}"
  local option="${3:-}"

  # 1. Validate arguments. Allow --force with the default label too.
  if [[ "$label" == "--force" && $# -eq 2 ]]; then
    label="github"
    option="--force"
  fi

  if [[ -z "$email" || $# -gt 3 || (-n "$option" && "$option" != "--force") ]]; then
    printf 'Usage: github_ssh_setup EMAIL [LABEL] [--force]\n' >&2
    return 1
  fi
  if [[ ! "$label" =~ ^[a-zA-Z0-9][a-zA-Z0-9._-]*$ ]]; then
    printf 'Label must start with a letter or digit and contain only letters, digits, dots, underscores, or hyphens.\n' >&2
    return 1
  fi

  # 2. Define the paths and prepare the SSH directory.
  local ssh_dir="$HOME/.ssh"
  local private_key="$ssh_dir/id_ed25519_$label"
  local public_key="$private_key.pub"
  local key_file

  mkdir -p -- "$ssh_dir" || return 1
  chmod 700 -- "$ssh_dir" || return 1

  for key_file in "$private_key" "$public_key"; do
    if [[ -L "$key_file" || (-e "$key_file" && ! -f "$key_file") ]]; then
      printf 'Expected a regular key file: %s\n' "$key_file" >&2
      return 1
    fi
  done

  # 3. --force moves existing keys to a unique backup directory.
  if [[ "$option" == "--force" && (-f "$private_key" || -f "$public_key") ]]; then
    local backup_dir
    backup_dir="$(mktemp -d "$ssh_dir/${label}.backup.XXXXXX")" || return 1
    printf 'Backing up existing keys to: %s\n' "$backup_dir"
    for key_file in "$private_key" "$public_key"; do
      if [[ -f "$key_file" ]]; then
        mv -- "$key_file" "$backup_dir/" || return 1
      fi
    done
  fi

  # 4. Reuse the private key, or generate a new pair.
  if [[ -f "$private_key" ]]; then
    printf 'Reusing key: %s\n' "$private_key"
  else
    if [[ -f "$public_key" ]]; then
      printf 'A public key exists without its private key. Choose another label or use --force.\n' >&2
      return 1
    fi
    printf 'Generating key: %s\n' "$private_key"
    ssh-keygen -t ed25519 -a 64 -C "$email" -f "$private_key" || return 1
  fi

  # Recover a missing public key from an existing private key.
  if [[ ! -f "$public_key" ]]; then
    local public_key_text
    public_key_text="$(ssh-keygen -y -f "$private_key")" || return 1
    printf '%s\n' "$public_key_text" >"$public_key" || return 1
  fi

  # 5. Reuse the current agent. Exit code 2 means it cannot be reached.
  # Exit code 1 is normal when the agent has no keys loaded yet.
  local agent_status=0
  local agent_settings
  ssh-add -l >/dev/null 2>&1 || agent_status=$?
  case "$agent_status" in
  0 | 1) ;;
  2)
    agent_settings="$(ssh-agent -s)" || return 1
    eval "$agent_settings" >/dev/null || return 1
    ;;
  *)
    printf 'Could not check the SSH agent (exit %s).\n' "$agent_status" >&2
    return 1
    ;;
  esac
  ssh-add "$private_key" || return 1

  # 6. Display only the public key; adding it to GitHub is a manual step.
  printf '\nAdd this public key in GitHub Settings > SSH and GPG keys:\n'
  cat -- "$public_key" || return 1
  printf '\nAfter adding it, test with:\n'
  printf 'ssh -i %q -o IdentitiesOnly=yes -T git@github.com\n' "$private_key"
}
alias certify_ssh="ssh -T git@github.com"

