# ==============================================================================
# GitHub SSH configuration
# ==============================================================================

github_ssh_setup() {
  local EMAIL="$1"
  local LABEL="${2:-github}"
  local FORCE="${3:-}"

  if [ -z "$EMAIL" ]; then
    echo "Usage: github_ssh_setup your_email@example.com [label] [--force]"
    echo "Example: github_ssh_setup me@domain.com myuser --force"
    return 1
  fi

  local KEY_PATH="$HOME/.ssh/id_ed25519_${LABEL}"

  mkdir -p "$HOME/.ssh"
  chmod 700 "$HOME/.ssh"

  if [ "$FORCE" = "--force" ]; then
    local timestamp
    timestamp="$(date +%Y%m%d_%H%M%S)"

    [ -f "$KEY_PATH" ] &&
      mv -f "$KEY_PATH" "${KEY_PATH}.bak.${timestamp}"

    [ -f "${KEY_PATH}.pub" ] &&
      mv -f "${KEY_PATH}.pub" "${KEY_PATH}.pub.bak.${timestamp}"
  fi

  if [ -f "$KEY_PATH" ]; then
    echo "[INFO] SSH key already exists at $KEY_PATH"
  else
    echo "[INFO] Generating new ED25519 SSH key at $KEY_PATH..."
    ssh-keygen -t ed25519 -a 64 -C "$EMAIL" -f "$KEY_PATH" || return 1
  fi

  eval "$(ssh-agent -s)" >/dev/null 2>&1
  ssh-add "$KEY_PATH" || return 1

  echo
  echo "===== COPY THIS PUBLIC KEY TO GITHUB ====="
  cat "${KEY_PATH}.pub"
  echo "=========================================="
  echo
  echo "Test with:"
  echo "ssh -i \"$KEY_PATH\" -o IdentitiesOnly=yes -T git@github.com"
}

alias certify_ssh="ssh -T git@github.com"

